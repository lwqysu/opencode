# OpenCode 服务环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ===== 必需配置 =====

# 服务器访问密码（必需设置，否则服务不安全）
OPENCODE_SERVER_PASSWORD=your-secure-password-here

# ===== 可选配置 =====

# 运行环境
NODE_ENV=production

# 日志配置
OPENCODE_PRINT_LOGS=1
OPENCODE_LOG_LEVEL=INFO

# 服务端口（容器内部端口）
# PORT=3000

# ===== 其他可能需要的配置 =====

# 如果使用外部数据库
# DATABASE_URL=

# 如果需要配置代理
# HTTP_PROXY=
# HTTPS_PROXY=

# 其他 OpenCode 特定配置
# OPENCODE_PURE=1
